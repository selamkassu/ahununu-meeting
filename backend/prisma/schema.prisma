// Ahununu Logistics - Meeting Management Portal
// Prisma schema — PRODUCTION target: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- RBAC: Roles & Permissions ----------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

// ---------- Core organizational structure ----------

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  headId      String?  // optional Department Head (FK -> User)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  head         User?         @relation("DepartmentHead", fields: [headId], references: [id])
  users        User[]        @relation("DepartmentMembers")
  meetings     Meeting[]
  actionItems  ActionItem[]
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  roleId           String
  jobTitle         String?
  avatarColor      String   @default("#0B7A6B")
  isActive         Boolean  @default(true)
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED | DEACTIVATED
  phone            String?
  responsibilities String?
  departmentId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  role                  Role                   @relation(fields: [roleId], references: [id])
  department            Department?            @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headOfDepartments     Department[]           @relation("DepartmentHead")
  organizedMeetings     Meeting[]              @relation("MeetingOrganizer")
  approvedMeetings      Meeting[]              @relation("MeetingApprover")
  participations        MeetingParticipant[]
  assignedActions       ActionItem[]           @relation("ActionAssignee")
  minutesAuthored       MeetingMinutes[]
  attendeeMinutes       MeetingMinutes[]       @relation("AttendeeMinutes")
  notifications         Notification[]
  documents             Document[]
  participantSignatures ParticipantSignature[]
}

// ---------- Meetings ----------

// Status: SCHEDULED | IN_PROGRESS | PENDING_SIGNATURES | READY_FOR_APPROVAL | APPROVED | COMPLETED | CANCELLED
// Priority: LOW | MEDIUM | HIGH | CRITICAL
model Meeting {
  id                    String    @id @default(cuid())
  code                  String    @unique
  title                 String
  description           String?
  date                  DateTime
  startTime             String
  endTime               String
  location              String?
  onlineLink            String?
  priority              String    @default("MEDIUM")
  status                String    @default("SCHEDULED")
  organizerId           String
  departmentId          String
  approvedById          String?
  approvedAt            DateTime?
  approvalSignature     String?
  attendanceFinalized   Boolean   @default(false)
  attendanceFinalizedAt DateTime?
  signaturesRequestedAt DateTime?
  forceApproved         Boolean   @default(false)
  bypassReason          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organizer              User                   @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  approvedBy             User?                  @relation("MeetingApprover", fields: [approvedById], references: [id])
  department             Department             @relation(fields: [departmentId], references: [id])
  participants           MeetingParticipant[]
  agendaItems            AgendaItem[]
  minutes                MeetingMinutes[]
  decisions              Decision[]
  actionItems            ActionItem[]
  documents              Document[]
  notifications          Notification[]
  participantSignatures  ParticipantSignature[]
}

// Status: INVITED | ACCEPTED | DECLINED | ATTENDED | ABSENT
model MeetingParticipant {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String
  status      String   @default("INVITED")
  isRequired  Boolean  @default(true)
  participated Boolean @default(false)
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

// Status: PENDING | DISCUSSED | DEFERRED
model AgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  order       Int      @default(0)
  title       String
  description String?
  presenter   String?
  durationMin Int      @default(15)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// type: SUMMARY | ATTENDEE
model MeetingMinutes {
  id           String   @id @default(cuid())
  meetingId    String
  type         String   @default("SUMMARY") // SUMMARY | ATTENDEE
  attendeeId   String?  // FK -> User (for ATTENDEE type only)
  attendeeName String?  // snapshot of attendee name
  content      String
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])
  attendee   User?   @relation("AttendeeMinutes", fields: [attendeeId], references: [id])

  @@unique([meetingId, attendeeId]) // one record per attendee per meeting (NULL for summary)
}

// Status: OPEN | IMPLEMENTED | REVERSED
model Decision {
  id           String   @id @default(cuid())
  meetingId    String
  code         String   @unique
  title        String
  description  String?
  decisionDate DateTime @default(now())
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())

  meeting     Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actionItems ActionItem[]
}

// Status: PENDING | IN_PROGRESS | COMPLETED | CANCELLED
// Priority: LOW | MEDIUM | HIGH | CRITICAL
model ActionItem {
  id              String    @id @default(cuid())
  code            String    @unique
  meetingId       String
  decisionId      String?
  title           String
  description     String?
  assignedToId    String
  departmentId    String
  priority        String    @default("MEDIUM")
  status          String    @default("PENDING")
  progressPercent Int       @default(0)
  deadline        DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decision   Decision?  @relation(fields: [decisionId], references: [id])
  assignedTo User       @relation("ActionAssignee", fields: [assignedToId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  meetingId    String
  fileName     String
  fileType     String   @default("application/octet-stream")
  fileSize     Int      @default(0)
  storedName   String?
  filePath     String?
  uploadedById String
  createdAt    DateTime @default(now())

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

// Type: MEETING_INVITATION | MEETING_UPDATED | MEETING_CANCELLED | ACTION_ITEM_ASSIGNED | MEETING_REMINDER
model Notification {
  id        String   @id @default(cuid())
  userId    String
  meetingId String?
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

// Participant digital signature captured during PENDING_SIGNATURES phase
model ParticipantSignature {
  id               String   @id @default(cuid())
  meetingId        String
  userId           String
  signerName       String
  signerRole       String?
  signatureDataUrl String   @db.Text
  signedAt         DateTime @default(now())
  userAgent        String?
  bypassReason     String?  // set only when admin force-approved

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}
