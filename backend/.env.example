# ---- Production (SQL Server) ----
# Example: sqlserver://localhost:1433;database=ahununu_meetings;user=sa;password=YourPassword;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://HOST:1433;database=ahununu_meetings;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# ---- Local dev convenience (SQLite) ----
# If you're using prisma/schema.sqlite.prisma instead, set:
# DATABASE_URL="file:./dev.db"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
