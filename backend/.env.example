# ==============================================================================
# Ahununu Logistics — Meeting Management Portal (Backend Environment Configuration)
# ==============================================================================

# ---- Database ----
# PostgreSQL (e.g. Neon, Supabase, Render PostgreSQL) or SQLite for local dev
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ---- Authentication & Security ----
JWT_SECRET="replace-with-a-long-random-secret-key-for-jwt-signing"
JWT_EXPIRES_IN="8h"
PORT=4000

# ---- CORS Allowed Origins ----
# Comma-separated list of allowed frontend URLs (e.g. http://localhost:5173 or https://your-frontend.onrender.com)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,https://your-frontend.onrender.com"

# ---- Frontend Application URL (Used for Meeting RSVP links in emails) ----
# Set this to your deployed frontend domain so links in notification emails work!
APP_URL="https://your-frontend.onrender.com"

# ==============================================================================
# EMAIL NOTIFICATION PROVIDERS
# ==============================================================================
# IMPORTANT FOR RENDER DEPLOYMENTS:
# Render Free tier blocks outbound SMTP ports 25, 465, and 587.
# Therefore, standard Gmail SMTP will hang/fail on Render Free tier.
# Use Option A (Resend) or Option B (Brevo) on Render for 100% reliable HTTP delivery (Port 443).
#
# ------------------------------------------------------------------------------
# OPTION A: RESEND (RECOMMENDED FOR RENDER & CLOUD)
# Free 3,000 emails/month. Uses HTTPS REST API on port 443 (never blocked by Render).
# 1. Sign up free at https://resend.com
# 2. Generate an API Key (re_...)
# 3. Add RESEND_API_KEY to Render Environment Variables
# ------------------------------------------------------------------------------
# RESEND_API_KEY="re_123456789abcdef"
# EMAIL_FROM="Ahununu Meeting Portal <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# OPTION B: BREVO / SENDINBLUE (FREE 300 EMAILS / DAY FOREVER)
# Free tier gives 300 emails/day without credit card. Uses HTTPS REST API on port 443.
# 1. Sign up free at https://brevo.com
# 2. Get API key from Settings -> SMTP & API -> API Keys (xkeysib-...)
# 3. Add BREVO_API_KEY to Render Environment Variables
# ------------------------------------------------------------------------------
# BREVO_API_KEY="xkeysib-..."
# BREVO_SENDER_EMAIL="your-verified-email@gmail.com"

# ------------------------------------------------------------------------------
# OPTION C: SENDGRID (HTTP API)
# ------------------------------------------------------------------------------
# SENDGRID_API_KEY="SG...."
# EMAIL_FROM="notifications@yourdomain.com"

# ------------------------------------------------------------------------------
# OPTION D: CUSTOM SMTP / RELAY (USE PORT 2525 ON RENDER)
# Port 2525 is typically unblocked on Render Free tier.
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=2525
# SMTP_USER="your-login"
# SMTP_PASS="your-smtp-key"
# SMTP_SECURE=false

# ------------------------------------------------------------------------------
# OPTION E: GMAIL SMTP (FOR LOCALHOST DEV OR PAID CLOUD INSTANCES)
# Works on localhost. On Render Free tier, ports 465/587 are blocked at firewall.
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate 16-character App Password
# ------------------------------------------------------------------------------
GMAIL_USER="Selamkassu7@gmail.com"
GMAIL_APP_PASSWORD="bcsh vkti kktg hghk"
